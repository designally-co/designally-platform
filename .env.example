# Supabase Postgres. Leave unset to run on the local PGlite database in .pglite/
# Use the pooled connection string; postgres-js is configured with prepare:false.
DATABASE_URL=

# Auth.js. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, restricted to the designally.co Workspace.
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# Required in production — the app refuses to start without it.
# Leave unset locally to use the development sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Not needed until milestone 3.
ANTHROPIC_API_KEY=
