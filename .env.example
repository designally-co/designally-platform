# Neon Postgres. Leave unset to run on the local PGlite database in .pglite/
# Use the POOLED string (host contains "-pooler") — postgres-js is configured with
# prepare:false because the pooler runs in transaction mode.
# For migrations, use the direct string instead; see README.
DATABASE_URL=

# Auth.js. Generate one with: npx auth secret
AUTH_SECRET=

# Google OAuth client, restricted to the designally.co Workspace.
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# Required in production — the app refuses to start without it.
# Leave unset locally to use the development sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Not needed until milestone 3.
ANTHROPIC_API_KEY=

# Where a client's survey link points. Leave unset and the app uses the host it
# is actually served from, so the link the team copies always resolves.
# Set this to https://designally.co once that domain routes /s/* and /c/* here.
SURVEY_ORIGIN=
